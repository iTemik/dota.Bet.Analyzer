{
    "name": "dota-bet-analyzer",
    "description": "Dota 2 Bet Analyzer - Multi-service development environment",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run backend\" \"npm run celery\" \"npm run frontend\"",
        "backend": "node scripts/run-with-venv.js \"python -m flask --app backend --debug run --port=5000\"",
        "celery": "node scripts/run-with-venv.js \"python -m celery -A backend.dota_bet_analyzer.celery worker --loglevel=info --pool=solo\"",
        "frontend": "cd frontend && npm run dev",
        "test": "npm run test:backend && npm run test:frontend",
        "test:backend": "node scripts/run-with-venv.js \"python -m pytest . -q\"",
        "test:frontend": "cd frontend && npm test -- --run"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
